{
  "name": "@tomismeta/aperture",
  "version": "0.8.0",
  "private": false,
  "description": "The live attention surface for humans working with agents.",
  "author": "tomismeta <tomismeta@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tomismeta/aperture#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomismeta/aperture.git",
    "directory": "packages/aperture"
  },
  "bugs": {
    "url": "https://github.com/tomismeta/aperture/issues"
  },
  "keywords": [
    "ai-agents",
    "local-first",
    "human-in-the-loop",
    "attention-management",
    "claude-code",
    "codex",
    "opencode",
    "tui",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "aperture": "dist/cli.js"
  },
  "exports": {
    "./work": {
      "types": "./dist/work.d.ts",
      "default": "./dist/work.js"
    },
    "./omp-attention-event": {
      "types": "./dist/omp-attention-event.d.ts",
      "default": "./dist/omp-attention-event.js"
    },
    "./omp-direct-message": {
      "types": "./dist/omp-direct-message.d.ts",
      "default": "./dist/omp-direct-message.js"
    },
    "./omp-attention-event.schema.json": "./dist/omp-attention-event.schema.json",
    "./omp-direct-message.schema.json": "./dist/omp-direct-message.schema.json",
    "./surface-protocol.schema.json": "./dist/surface-protocol.schema.json",
    "./notification-worker-input.schema.json": "./dist/notification-worker-input.schema.json",
    "./notification-worker-output.schema.json": "./dist/notification-worker-output.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts && tsc --project ../../tsconfig.work-public.json --emitDeclarationOnly --pretty false",
    "build:attention-worker": "pnpm run build && tsx ./scripts/build-attention-worker-artifact.ts",
    "build:attention-worker:development": "pnpm run build && tsx ./scripts/build-attention-worker-artifact.ts --allow-unsigned-local",
    "finalize:attention-worker": "tsx ./scripts/finalize-attention-worker-buildinfo.ts",
    "smoke": "tsx ./scripts/smoke.ts",
    "smoke:attention-worker": "tsx ./scripts/smoke-attention-worker.ts",
    "smoke:omp-extension": "tsx ./scripts/smoke-omp-extension.ts",
    "smoke:omp-direct-worker": "tsx ./scripts/smoke-omp-direct-worker.ts",
    "smoke:omp-host-direct": "tsx ./scripts/smoke-omp-host-direct.ts",
    "omp:fixtures:check": "tsx ./scripts/generate-omp-direct-fixtures.ts",
    "omp:fixtures:write": "tsx ./scripts/generate-omp-direct-fixtures.ts --write",
    "surface:fixtures:check": "tsx ./scripts/generate-surface-fixtures.ts",
    "surface:fixtures:write": "tsx ./scripts/generate-surface-fixtures.ts --write",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "tsx": "^4.20.5"
  }
}
