{
  "name": "@tomismeta/aperture-core",
  "version": "0.4.0",
  "description": "The human attention control plane for agent systems.",
  "author": "tomismeta <tomismeta@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tomismeta/aperture#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomismeta/aperture.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/tomismeta/aperture/issues"
  },
  "keywords": [
    "ai-agents",
    "multi-agent",
    "agent-orchestration",
    "attention-management",
    "control-plane",
    "human-in-the-loop",
    "judgment-engine",
    "decision-engine",
    "interrupt-management",
    "approval-workflows",
    "typescript"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "main": "./public-dist/index.js",
  "types": "./public-dist/index.d.ts",
  "files": [
    "public-dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./public-dist/index.d.ts",
      "default": "./public-dist/index.js"
    },
    "./semantic": {
      "types": "./public-dist/semantic.d.ts",
      "default": "./public-dist/semantic.js"
    }
  },
  "scripts": {
    "build": "tsc -b --force --pretty false && tsup",
    "prepack": "pnpm run build"
  },
  "sideEffects": false,
  "devDependencies": {
    "tsup": "^8.5.1"
  }
}
