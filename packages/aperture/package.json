{
  "name": "@tomismeta/aperture",
  "version": "0.5.0",
  "private": false,
  "description": "The live attention surface for humans working with agents.",
  "author": "tomismeta <tomismeta@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/tomismeta/aperture#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tomismeta/aperture.git",
    "directory": "packages/aperture"
  },
  "bugs": {
    "url": "https://github.com/tomismeta/aperture/issues"
  },
  "keywords": [
    "ai-agents",
    "local-first",
    "human-in-the-loop",
    "attention-management",
    "claude-code",
    "codex",
    "opencode",
    "tui",
    "cli"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  },
  "type": "module",
  "bin": {
    "aperture": "dist/cli.js"
  },
  "exports": {
    "./work": {
      "types": "./dist/work.d.ts",
      "default": "./dist/work.js"
    },
    "./surface-protocol.schema.json": "./dist/surface-protocol.schema.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts && tsc --project ../../tsconfig.work-public.json --emitDeclarationOnly --pretty false",
    "smoke": "tsx ./scripts/smoke.ts",
    "surface:fixtures:check": "tsx ./scripts/generate-surface-fixtures.ts",
    "surface:fixtures:write": "tsx ./scripts/generate-surface-fixtures.ts --write",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "tsx": "^4.20.5"
  }
}
