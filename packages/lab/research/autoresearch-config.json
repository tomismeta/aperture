{
  "name": "aperture-lab-fstop",
  "version": 1,
  "objective": "Improve Aperture's semantic interpretation and importer mapping using offline disagreement reports without changing the hot path contract.",
  "allowedEditPaths": [
    "packages/lab/src/public-trajectories.ts",
    "packages/core/src/semantic-detection.ts",
    "packages/core/src/semantic-interpreter.ts",
    "packages/core/src/semantic-language.ts",
    "packages/lab/src/offline-review.ts"
  ],
  "forbiddenEditPaths": [
    "packages/core/src/attention-planner.ts",
    "packages/core/src/aperture-core.ts",
    "packages/runtime",
    "packages/aperture",
    "packages/tui",
    "packages/paperclip",
    "docs/releases"
  ],
  "prepareCommands": [
    "pnpm lab:fstop:ingest --file <raw-export-path> --json",
    "pnpm lab:fstop:campaign --provider <provider> --reviewer-provider <provider> --optimizer-provider <provider> --json",
    "pnpm lab:fstop:service --provider <provider> --reviewer-provider <provider> --optimizer-provider <provider> --json",
    "pnpm lab:fstop:run --provider <provider> --reviewer-provider <provider> --optimizer-provider <provider> --json",
    "APERTURE_OPENCLAW_REVIEW_TIMEOUT=60 pnpm lab:fstop:review --dataset swe-smith --split tool --limit 3 --reviewer-provider <provider> --json",
    "pnpm lab:fstop:propose --reviewer-provider <provider> --optimizer-provider <provider> --json",
    "pnpm trajectory:import --dataset swe-smith --split tool --limit 3",
    "pnpm lab:fstop:prepare --bundle <bundle-path> --json",
    "pnpm lab:fstop:review:run --artifact <artifact-path> --reviewer-command \"pnpm lab:fstop:reviewer --provider <provider>\" --json",
    "pnpm lab:fstop:promote --report <report-path> --split train --json",
    "pnpm lab:fstop:evaluate --json",
    "pnpm lab:fstop:cycle --json",
    "pnpm lab:fstop:optimize --provider <provider> --json"
  ],
  "reviewerCommandTemplates": {
    "hermes": "pnpm lab:fstop:reviewer --provider hermes",
    "openclaw": "pnpm lab:fstop:reviewer --provider openclaw",
    "generic": "pnpm lab:fstop:reviewer --provider generic"
  },
  "runnerCommandTemplates": {
    "hermes": "pnpm lab:fstop:runner --provider hermes",
    "openclaw": "pnpm lab:fstop:runner --provider openclaw",
    "generic": "pnpm lab:fstop:runner --provider generic"
  },
  "optimizerCommandTemplates": {
    "hermes": "pnpm lab:fstop:optimizer --provider hermes",
    "openclaw": "pnpm lab:fstop:optimizer --provider openclaw",
    "generic": "pnpm lab:fstop:optimizer --provider generic"
  },
  "evaluationCommands": [
    "pnpm exec tsx --test packages/lab/test/autoresearch-calibration.test.ts packages/lab/test/offline-review.test.ts packages/lab/test/public-trajectories.test.ts",
    "pnpm lab:fstop:evaluate --json",
    "pnpm judgment:battle",
    "pnpm release:check"
  ],
  "resultArtifacts": {
    "campaignStateDir": ".aperture/lab/campaigns",
    "serviceStateDir": ".aperture/lab/service",
    "rawBundlesDir": ".aperture/lab/bundles/raw",
    "calibrationDir": "packages/lab/calibration",
    "reviewRequestsDir": ".aperture/lab/results/offline-review/requests",
    "reviewPromptsDir": ".aperture/lab/results/offline-review/prompts",
    "reviewRawDir": ".aperture/lab/results/offline-review/raw",
    "reviewResponsesDir": ".aperture/lab/results/offline-review/responses",
    "disagreementsDir": ".aperture/lab/results/offline-review/disagreements",
    "recommendationsDir": ".aperture/lab/results/offline-review/recommendations",
    "runsDir": ".aperture/lab/results/offline-review/runs",
    "autoresearchEvaluationsDir": ".aperture/lab/results/autoresearch/evaluations",
    "autoresearchBriefsDir": ".aperture/lab/results/autoresearch/briefs",
    "autoresearchOptimizerDir": ".aperture/lab/results/autoresearch/optimizer",
    "autoresearchProposalsDir": ".aperture/lab/results/autoresearch/proposals",
    "currentReportJsonPath": ".aperture/lab/current-campaign/current-report.json",
    "currentReportMarkdownPath": ".aperture/lab/current-campaign/current-report.md",
    "battleResultsDir": ".aperture/lab/results"
  },
  "successCriteria": [
    "Corrected mismatch count goes down on the train corpus.",
    "Invariant mismatch count stays at zero.",
    "Held-out disagreement cases do not regress.",
    "Judgment battle remains fully green.",
    "Release check remains fully green."
  ],
  "nonGoals": [
    "Do not add an LLM to the live judgment path.",
    "Do not optimize continuity or planner behavior in this loop.",
    "Do not auto-merge changes."
  ]
}
