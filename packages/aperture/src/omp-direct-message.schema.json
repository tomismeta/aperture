{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tomismeta:aperture:omp-direct-message:v3",
  "title": "Aperture OMP Private Direct Message",
  "oneOf": [
    { "$ref": "omp-attention-event.schema.json" },
    { "$ref": "#/$defs/focusRegistration" },
    { "$ref": "#/$defs/focusRevocation" }
  ],
  "$defs": {
    "token": { "type": "string", "pattern": "^[A-Za-z0-9_-]{32}$" },
    "requestId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
    },
    "hyprlandInstance": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9_.-]+$"
    },
    "socketPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^/[^\\u0000]*$"
    },
    "target": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "socketPath", "paneId", "hyprlandInstance"],
          "properties": {
            "kind": { "const": "herdr" },
            "socketPath": { "$ref": "#/$defs/socketPath" },
            "paneId": {
              "type": "string",
              "maxLength": 64,
              "pattern": "^w[A-Za-z0-9_-]{1,30}:p[A-Za-z0-9_-]{1,30}$"
            },
            "hyprlandInstance": { "$ref": "#/$defs/hyprlandInstance" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "marker", "hyprlandInstance"],
          "properties": {
            "kind": { "const": "direct-foot" },
            "marker": { "$ref": "#/$defs/token" },
            "hyprlandInstance": { "$ref": "#/$defs/hyprlandInstance" }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "socketPath", "paneId", "hyprlandInstance"],
          "properties": {
            "kind": { "const": "tmux" },
            "socketPath": { "$ref": "#/$defs/socketPath" },
            "paneId": { "type": "string", "pattern": "^%[0-9]{1,10}$" },
            "hyprlandInstance": { "$ref": "#/$defs/hyprlandInstance" }
          }
        }
      ]
    },
    "focusRegistration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "requestId", "publicHandle", "hostGeneration", "target"],
      "properties": {
        "schemaVersion": { "const": 3 },
        "type": { "const": "omp.focus.register" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "publicHandle": { "$ref": "#/$defs/token" },
        "hostGeneration": { "$ref": "#/$defs/token" },
        "target": { "$ref": "#/$defs/target" }
      }
    },
    "focusRevocation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "type", "requestId", "publicHandle", "hostGeneration"],
      "properties": {
        "schemaVersion": { "const": 3 },
        "type": { "const": "omp.focus.revoke" },
        "requestId": { "$ref": "#/$defs/requestId" },
        "publicHandle": { "$ref": "#/$defs/token" },
        "hostGeneration": { "$ref": "#/$defs/token" }
      }
    }
  }
}
