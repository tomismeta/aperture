    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^10.2.0",
    "fast-check": "^4.6.0",
    "globals": "^17.4.0",
    "prettier": "^3.8.2",
