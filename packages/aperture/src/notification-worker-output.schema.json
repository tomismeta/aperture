{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:tomismeta:aperture:notification-worker-output:v3",
  "title": "Aperture Notification Worker Output",
  "oneOf": [
    { "$ref": "#/$defs/hello" },
    { "$ref": "#/$defs/engine" },
    { "$ref": "#/$defs/error" },
    { "$ref": "#/$defs/focusResult" },
    {
      "allOf": [
        { "$ref": "urn:tomismeta:aperture:surface-protocol:v3" },
        {
          "type": "object",
          "properties": {
            "type": { "const": "snapshot" }
          }
        }
      ]
    }
  ],
  "$defs": {
    "hello": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "packageVersion", "worker", "capabilities"],
      "properties": {
        "type": { "const": "hello" },
        "packageVersion": { "type": "string", "minLength": 1, "maxLength": 120 },
        "worker": { "const": "aperture-attention-engine" },
        "capabilities": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "notificationInput",
            "ompDirectInput",
            "snapshots",
            "responses",
            "focusActivation"
          ],
          "properties": {
            "notificationInput": { "const": true },
            "ompDirectInput": { "const": true },
            "snapshots": { "const": true },
            "responses": { "const": false },
            "focusActivation": { "const": true }
          }
        }
      }
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "state", "acceptedSources"],
      "properties": {
        "type": { "const": "engine" },
        "state": { "enum": ["restoring", "ready", "degraded"] },
        "acceptedSources": { "type": "integer", "minimum": 0 }
      }
    },
    "focusResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "requestId", "result"],
      "properties": {
        "type": { "const": "focus.result" },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "pattern": "^(?=.*\\S)[^\\u0000-\\u001F\\u007F]+$"
        },
        "result": { "enum": ["focused", "stale", "missing"] }
      }
    },
    "error": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "code", "message", "recoverable"],
      "properties": {
        "type": { "const": "error" },
        "code": { "type": "string", "minLength": 1, "maxLength": 80 },
        "message": { "type": "string", "minLength": 1, "maxLength": 400 },
        "recoverable": { "type": "boolean" }
      }
    }
  }
}
